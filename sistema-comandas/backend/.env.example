PORT=3001

# Financeiro — senha apenas da Maria (obrigatório para listar histórico / valores)
FINANCEIRO_MARIA_SENHA=

# Opcional — assinatura do token da sessão (em produção defina algo longo e aleatório)
# FINANCEIRO_SESSAO_SEGREDO=
# TTL da sessão após entrar na senha Maria (ms, padrão 12 horas)
# FINANCEIRO_SESSAO_TTL_MS=

CORS_ORIGIN=http://localhost:5173
FIREBASE_PROJECT_ID=seu-projeto-firebase
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu-projeto-firebase.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_AQUI\n-----END PRIVATE KEY-----\n"

# Reduz leituras no boot e em GETs repetidos (recomendado se cota Firestore estourou)
# DISABLE_STARTUP_SEED=true
# READ_CACHE_TTL_MS=60000
